{
  "description": "Hand-written allowlist for the kids' editor (EDITOR_SPEC.md section 6). tools/lottie3d_catalog.mjs reads it with engine3d/catalog and writes kids.json. Only what is listed here is exported. mode: the lowest editor mode that shows the item (tiny, maker, animator). from: the engine3d catalog table an item comes from (characters, critters, props) or rigs for the built-in Lottie3D rigs. needs: the capability a move requires (body, face, limbs, joints, clips, camera). engine3d: the engine3d action a move is modelled on (its description is copied). A move with no engine3d source gives its own description.",
  "stages": {
    "garden": { "label": "Garden", "emoji": "🌻", "mode": "tiny" },
    "playroom": { "label": "Playroom", "emoji": "🧸", "mode": "tiny" },
    "beach": { "label": "Beach", "emoji": "🏖️", "mode": "tiny" },
    "snow": { "label": "Snow", "emoji": "⛄", "mode": "tiny" },
    "space": { "label": "Space", "emoji": "🚀", "mode": "tiny" }
  },
  "models": {
    "robot": { "from": "characters", "label": "Robo", "emoji": "🤖", "group": "people", "mode": "tiny" },
    "stick": { "from": "rigs", "label": "Stick kid", "emoji": "🧍", "group": "people", "mode": "tiny" },
    "block": { "from": "rigs", "label": "Block kid", "emoji": "🧱", "group": "people", "mode": "tiny" },
    "duck": { "from": "critters", "label": "Duck", "emoji": "🐤", "group": "animals", "mode": "tiny" },
    "dog": { "from": "critters", "label": "Dog", "emoji": "🐶", "group": "animals", "mode": "tiny" },
    "cat": { "from": "critters", "label": "Cat", "emoji": "🐱", "group": "animals", "mode": "tiny" },
    "bunny": { "from": "critters", "label": "Bunny", "emoji": "🐰", "group": "animals", "mode": "tiny" },
    "frog": { "from": "critters", "label": "Frog", "emoji": "🐸", "group": "animals", "mode": "tiny" },
    "ball": { "from": "props", "label": "Ball", "emoji": "⚽", "group": "things", "mode": "tiny" },
    "apple": { "from": "props", "label": "Apple", "emoji": "🍎", "group": "things", "mode": "tiny" },
    "balloon": { "from": "props", "label": "Balloon", "emoji": "🎈", "group": "things", "mode": "tiny" },
    "gift": { "from": "props", "label": "Gift", "emoji": "🎁", "group": "things", "mode": "tiny" },
    "tree": { "from": "props", "label": "Tree", "emoji": "🌳", "group": "things", "mode": "tiny" },
    "flower": { "from": "props", "label": "Flower", "emoji": "🌷", "group": "things", "mode": "tiny" },
    "sun": { "from": "props", "label": "Sun", "emoji": "☀️", "group": "things", "mode": "tiny" },
    "cloud": { "from": "props", "label": "Cloud", "emoji": "☁️", "group": "things", "mode": "tiny" }
  },
  "moves": {
    "hop": { "engine3d": "hop", "label": "Hop", "emoji": "🐇", "mode": "tiny", "needs": "body", "dur": 0.6, "options": { "height": { "type": "number", "default": 0.5, "min": 0.1, "max": 3 }, "times": { "type": "int", "default": 1, "min": 1, "max": 10 } }
    },
    "spin": { "engine3d": "spin", "label": "Spin", "emoji": "🌀", "mode": "tiny", "needs": "body", "dur": 1, "options": { "turns": { "type": "number", "default": 1, "min": -5, "max": 5 } }
    },
    "wiggle": { "engine3d": "wiggle", "label": "Wiggle", "emoji": "〰️", "mode": "tiny", "needs": "body", "dur": 0.8, "options": { "amount": { "type": "number", "default": 12, "min": 2, "max": 40 } }
    },
    "nod": { "engine3d": "nod", "label": "Nod", "emoji": "🙂", "mode": "tiny", "needs": "body", "dur": 0.8, "options": { "amount": { "type": "number", "default": 15, "min": 3, "max": 40 }, "times": { "type": "int", "default": 2, "min": 1, "max": 6 } }
    },
    "show": { "engine3d": "show", "label": "Pop in", "emoji": "✨", "mode": "tiny", "needs": "body", "dur": 0.5, "options": {}
