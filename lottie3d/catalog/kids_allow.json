    "grow": { "engine3d": "grow", "label": "Grow", "emoji": "⬆️", "mode": "maker", "needs": "body", "dur": 0.6, "options": { "to": { "type": "number", "default": 1.5, "min": 0.2, "max": 4 } }
    },
    "shrink": { "engine3d": "grow", "label": "Shrink", "emoji": "⬇️", "mode": "maker", "needs": "body", "dur": 0.6, "options": { "to": { "type": "number", "default": 0.6, "min": 0.2, "max": 4 } }
    },
    "walk_to": { "engine3d": "move", "label": "Walk to", "emoji": "🚶", "mode": "maker", "needs": "body", "dur": 2, "options": { "to": { "type": "point", "required": true } }
    },
    "leap": { "engine3d": "leap", "label": "Leap", "emoji": "🦘", "mode": "maker", "needs": "body", "dur": 0.9, "options": { "to": { "type": "point", "required": true }, "height": { "type": "number", "default": 1, "min": 0.2, "max": 4 } }
    },
    "roll": { "engine3d": "roll", "label": "Roll", "emoji": "🎳", "mode": "maker", "needs": "body", "dur": 1.2, "options": { "distance": { "type": "number", "default": 2, "min": -10, "max": 10 } }
    },
    "turn": { "engine3d": "turn", "label": "Turn", "emoji": "↪️", "mode": "maker", "needs": "body", "dur": 0.6, "options": { "to": { "type": "number", "default": 0, "min": -360, "max": 360 } }
    },
    "look_at": { "engine3d": "look", "label": "Look at", "emoji": "👀", "mode": "maker", "needs": "body", "dur": 0.6, "options": { "target": { "type": "cast", "required": true } }
    },
    "say": { "engine3d": "say", "label": "Say", "emoji": "💬", "mode": "maker", "needs": "body", "dur": 2, "options": { "words": { "type": "words", "required": true } }
    },
    "sound": { "engine3d": "sound", "label": "Sound", "emoji": "🔊", "mode": "maker", "needs": "body", "dur": 1, "options": { "name": { "type": "sound", "default": "own" } }
    },
    "clip": { "engine3d": "clip", "label": "Play move", "emoji": "🎞️", "mode": "maker", "needs": "clips", "dur": 2, "options": { "name": { "type": "clip", "required": true } }
    },
    "pose": { "engine3d": null, "label": "Pose", "emoji": "⭐", "mode": "animator", "needs": "joints", "dur": 1, "options": { "name": { "type": "pose", "required": true } }, "description": "Hold a saved pose (Animator mode): the joints turn to it and come back to rest at the end."
    },
    "wide": { "engine3d": "shot", "label": "Wide shot", "emoji": "🎥", "mode": "maker", "needs": "camera", "dur": 3, "options": {}
    },
    "close": { "engine3d": "shot", "label": "Close up", "emoji": "🔍", "mode": "maker", "needs": "camera", "dur": 3, "options": { "target": { "type": "cast", "required": true } }
    },
    "follow": { "engine3d": null, "label": "Follow", "emoji": "🎯", "mode": "maker", "needs": "camera", "dur": 3, "options": { "target": { "type": "cast", "required": true } }, "description": "Keep the camera on one cast member as it moves."
