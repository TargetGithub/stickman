    { "who": "dog", "at": 7.6, "do": "hop", "with": { "times": 3, "height": 0.4 }, "dur": 1.2 },
    { "who": "flower", "at": 9, "do": "grow", "with": { "to": 1.8 } },
    { "who": "sun", "at": 0, "do": "spin", "dur": 12, "with": { "turns": 1 } },
