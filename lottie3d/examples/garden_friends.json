    { "who": "robo", "at": 4, "do": "say", "with": { "words": ["wow"] }, "dur": 1.4 },
    { "who": "robo", "at": 8.4, "do": "dance", "dur": 3.4 },
    { "who": "dog", "at": 3.6, "do": "walk_to", "dur": 2.4, "with": { "to": [1.4, 0.2] } },
