{
  "kind": "video3d",
  "version": 1,
  "description": "A tour of the teaching kit for the batch 3 (grades 3-5) specs: number lines with leaps, fraction bars and circles, arrays, grids with perimeter traces, unit cubes, callouts, angles and pointers, with build, shade, leap, draw, open, mark, highlight and trace.",
  "meta": { "title": "engine3d teaching kit tour", "seed": 33, "voice": "soft", "music": false },
  "stage": { "preset": "playroom" },
  "camera": { "position": [0, 2.3, 9.2], "lookAt": [0, 0.75, 0.6], "fov": 40 },
  "objects": [
    { "id": "line10", "kind": "number_line", "from": 0, "to": 10, "length": 8, "at": [0, 0, 1.2], "hidden": true },
    { "id": "frog", "kind": "critter", "species": "frog", "size": 0.6, "on": { "line": "line10", "value": 0 }, "hidden": true },

    { "id": "bar", "kind": "fraction_bar", "parts": 4, "length": 3, "height": 0.6, "label": true, "at": [-2.3, 0, 0], "hidden": true },
    { "id": "pie", "kind": "fraction_circle", "parts": 8, "radius": 1.05, "color": "green", "label": true, "at": [2.3, 0, 0], "hidden": true },
    { "id": "quarters", "kind": "number_line", "from": 0, "to": 1, "length": 6, "minor": 4, "labels": "fractions", "color": "purple", "at": [0, 0, 1], "hidden": true },
    { "id": "ball", "kind": "shape", "shape": "sphere", "color": "orange", "size": 0.35, "on": { "line": "quarters", "value": 0 }, "hidden": true },

    { "id": "dots", "kind": "array", "rows": 3, "cols": 4, "size": 0.36, "gap": 0.18, "trays": true, "at": [-2.5, 0, 0], "hidden": true },
    { "id": "apples", "kind": "array", "rows": 2, "cols": 3, "item": "apple", "size": 0.5, "gap": 0.2, "at": [2.6, 0, 0], "hidden": true },

    { "id": "area", "kind": "grid", "rows": 3, "cols": 4, "cell": 0.55, "upright": true, "at": [-2.2, 0, 0], "hidden": true },
    { "id": "bed", "kind": "grid", "rows": 2, "cols": 3, "cell": 0.6, "color": "grass", "at": [2.6, 0, 0.6], "hidden": true },

    { "id": "boxed", "kind": "cubes", "l": 3, "w": 2, "h": 2, "cell": 0.45, "box": true, "at": [-1.8, 0, 0.3], "hidden": true },
    { "id": "boxed_label", "kind": "callout", "text": "12 cubes", "target": "boxed", "offset": [2.2, 0.9, 0], "hidden": true },

    { "id": "corner", "kind": "angle", "degrees": 30, "radius": 1.6, "at": [-3.6, 0.3, 0.4], "hidden": true },
    { "id": "sun", "kind": "prop", "model": "sun", "size": 0.8, "at": [0.6, 2.3, -0.6], "hidden": true },
    { "id": "plant", "kind": "prop", "model": "flowering_plant", "size": 1.1, "at": [3.2, 0, 0.3], "hidden": true },
    { "id": "ray", "kind": "pointer", "from": [1.3, 2.4, -0.4], "to": [2.8, 1.2, 0.3], "bend": 0.5, "color": "gold", "hidden": true },
    { "id": "plant_label", "kind": "callout", "text": "food from light", "target": "plant", "offset": [-0.6, 1.6, 0.4], "color": "leaf", "hidden": true }
  ],
  "scenes": [
    { "id": "numbers", "title": "Number lines", "beats": [
      { "dur": 3.4, "do": [
        { "do": "build", "target": "line10", "dur": 3 },
        { "do": "caption", "text": "build: a number line", "style": "label" }
      ] },
      { "dur": 1, "do": [{ "do": "pop", "target": "frog" }] },
      { "dur": 3.4, "do": [
        { "do": "leap", "target": "frog", "line": "line10", "values": [2, 4, 6, 8], "dur": 0.75, "height": 0.9 },
        { "do": "caption", "text": "leap: 2, 4, 6, 8", "style": "label" }
      ] },
      { "dur": 2.2, "do": [
        { "do": "mark", "target": "frog", "result": "correct" },
        { "do": "highlight", "target": "line10", "at": 0.3, "dur": 1.8 }
      ] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "frog" }, { "do": "hide", "target": "line10" }] }
    ] },
    { "id": "fractions", "title": "Fractions", "beats": [
      { "dur": 3, "do": [
        { "do": "build", "target": "bar" },
        { "do": "build", "target": "pie", "at": 0.4, "dur": 2.4 },
        { "do": "camera", "position": [0, 2.6, 9.4], "lookAt": [0, 1.1, 0], "dur": 1.5 },
        { "do": "caption", "text": "fraction bar and circle", "style": "label" }
      ] },
      { "dur": 2.4, "do": [
        { "do": "shade", "target": "bar", "to": 3 },
        { "do": "shade", "target": "pie", "to": 3, "at": 0.4, "sound": "pop" },
        { "do": "caption", "text": "shade: 3/4 and 3/8", "style": "label" }
      ] },
      { "dur": 2.4, "do": [
        { "do": "move", "target": "pie#s1", "to": [0.3, 0.2, 0.35], "dur": 0.8 },
        { "do": "highlight", "target": "pie#s1", "at": 0.8, "dur": 1.6 }
      ] },
      { "dur": 2, "do": [
        { "do": "mark", "target": "bar", "result": "correct" },
        { "do": "mark", "target": "pie#s4", "result": "incorrect", "at": 0.6 }
      ] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "bar" }, { "do": "hide", "target": "pie" }] },
      { "dur": 2.2, "do": [
        { "do": "draw", "target": "quarters", "dur": 1.6, "sound": "whoosh" },
        { "do": "camera", "position": [0, 2.2, 8.2], "lookAt": [0, 0.75, 0.6], "dur": 1.5 },
        { "do": "pop", "target": "ball", "at": 1.6 }
      ] },
      { "dur": 2.4, "do": [
        { "do": "leap", "target": "ball", "line": "quarters", "values": [0.25, 0.5, 0.75], "dur": 0.7, "height": 0.6, "color": "purple" },
        { "do": "caption", "text": "leap: 1/4, 2/4, 3/4", "style": "label" }
      ] },
      { "dur": 1.8, "do": [{ "do": "mark", "target": "ball", "result": "correct" }] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "ball" }, { "do": "hide", "target": "quarters" }] }
    ] },
    { "id": "arrays", "title": "Arrays", "beats": [
      { "dur": 2.6, "do": [
        { "do": "build", "target": "dots", "order": "rows", "dur": 1.8 },
        { "do": "build", "target": "apples", "at": 0.6, "dur": 1.8 },
        { "do": "camera", "position": [0, 2.4, 8.6], "lookAt": [0, 0.9, 0], "dur": 1.2 },
        { "do": "caption", "text": "array: 3 rows of 4", "style": "label" }
      ] },
      { "dur": 2.2, "do": [
        { "do": "shade", "target": "dots", "to": 4 },
        { "do": "highlight", "target": "dots#i6", "at": 1.2, "dur": 1 }
      ] },
      { "dur": 2, "do": [
        { "do": "mark", "target": "dots", "result": "correct" },
        { "do": "mark", "target": "apples#i5", "result": "incorrect", "at": 0.5 }
      ] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "dots" }, { "do": "hide", "target": "apples" }] }
    ] },
    { "id": "area", "title": "Area and perimeter", "beats": [
      { "dur": 3.2, "do": [
        { "do": "build", "target": "area", "dur": 2.6 },
        { "do": "build", "target": "bed", "order": "rows", "at": 0.8, "dur": 1.2 },
        { "do": "camera", "position": [0, 2.6, 8.8], "lookAt": [0, 0.9, 0], "dur": 1.2 },
        { "do": "caption", "text": "grid: 12 squares", "style": "label" }
      ] },
      { "dur": 5.4, "do": [
        { "do": "trace", "target": "area", "dur": 5 },
        { "do": "caption", "text": "trace: perimeter 14", "style": "label" }
      ] },
      { "dur": 2.2, "do": [
        { "do": "shade", "target": "area", "to": 4, "color": "green" },
        { "do": "highlight", "target": "bed", "at": 0.3, "dur": 1.8, "color": "pink" }
      ] },
      { "dur": 1.6, "do": [{ "do": "mark", "target": "area", "result": "correct" }] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "area" }, { "do": "hide", "target": "bed" }] }
    ] },
    { "id": "volume", "title": "Volume", "beats": [
      { "dur": 2.6, "do": [
        { "do": "build", "target": "boxed", "order": "layers", "dur": 1.6 },
        { "do": "camera", "position": [0, 3, 8.2], "lookAt": [0, 0.7, 0], "dur": 1.2 },
        { "do": "caption", "text": "cubes: 2 layers of 6", "style": "label" }
      ] },
      { "dur": 2, "do": [{ "do": "draw", "target": "boxed_label" }] },
      { "dur": 1.8, "do": [{ "do": "highlight", "target": "boxed", "dur": 1.6 }] },
      { "dur": 0.8, "do": [{ "do": "hide", "target": "boxed" }, { "do": "hide", "target": "boxed_label" }] }
    ] },
    { "id": "angles", "title": "Angles and arrows", "beats": [
      { "dur": 1.4, "do": [
        { "do": "pop", "target": "corner" },
        { "do": "camera", "position": [0, 2.4, 9.4], "lookAt": [0, 1.1, 0], "dur": 1.2 }
      ] },
      { "dur": 1.8, "do": [{ "do": "open", "target": "corner", "to": 90 }, { "do": "caption", "text": "open: 90", "style": "label" }] },
      { "dur": 1.8, "do": [{ "do": "open", "target": "corner", "to": 135 }] },
      { "dur": 2.4, "do": [
        { "do": "pop", "target": "sun" },
        { "do": "pop", "target": "plant", "at": 0.3 },
        { "do": "draw", "target": "ray", "at": 0.8, "dur": 1.2 }
      ] },
      { "dur": 2.6, "do": [
        { "do": "draw", "target": "plant_label" },
        { "do": "highlight", "target": "plant", "at": 1.2, "dur": 1.4, "color": "leaf" }
      ] },
      { "dur": 2, "do": [{ "do": "mark", "target": "corner", "result": "correct" }] }
    ] }
  ]
}
