          "macro": "dialogue",
          "params": {
            "lines": [
              [
                "peepa",
                "When I was angry. When the Hush was whispering every day.",
                "sad"
              ],
              [
                "peepa",
                "I stomped up this path, and I shouted terrible things at that door.",
                "sad"
              ],
              [
                "bijli",
                "Louder than me?",
                "surprised"
              ],
              [
                "peepa",
                "Much louder.",
                "sad"
