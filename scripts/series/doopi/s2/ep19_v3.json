          "params": {
            "text": "The last part of the path was steep and narrow. And Peepa walked slower and slower."
          }
        },
        {
          "id": "path_2",
          "at": {
            "after": "path_1"
          },
          "macro": "dialogue",
          "params": {
            "lines": [
              [
                "doopi",
                "Peepa? You're walking like Mooka before lunch.",
                "surprised"
              ],
              [
                "mooka",
                "Hey!",
                "angry"
              ],
              [
                "peepa",
                "I've been to the Echo Cave before. Long ago.",
                "sad"
              ],
              [
                "zippy",
                "Really? When?",
                "surprised"
