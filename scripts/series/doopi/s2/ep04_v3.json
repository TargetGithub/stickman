          "macro": "dialogue",
          "params": {
            "lines": [
              [
                "doomi",
                "Where is the Hush going now?",
                "determined"
              ],
              [
                "baba",
                "Home. To the Echo Cave, beyond the mountains.",
                "sad"
              ],
              [
                "baba",
                "If it gets there with enough big feelings, it will grow into a storm.",
                "scared"
              ],
              [
                "dony",
                "A storm of grey clouds?",
                "scared"
              ],
              [
                "baba",
                "Over the whole valley.",
                "sad"
              ]
            ]
          }
        },
        {
          "id": "legend_12",
          "at": {
            "after": "legend_11"
          },
          "macro": "dialogue",
          "params": {
            "lines": [
              [
                "doopi",
                "Then we'll stop it! We'll punch it right back into the horn!",
                "determined"
              ],
              [
                "baba",
                "Hmm. Did punching work on Chintu's cloud?",
                "happy"
              ],
              [
                "doopi",
                "...No. It made it bigger.",
                "sad"
              ],
              [
                "baba",
                "The Hush grows when it is fought. It shrinks when a feeling is heard.",
                "happy"
              ]
            ]
          }
        },
        {
          "id": "legend_13",
          "at": {
            "after": "legend_12"
