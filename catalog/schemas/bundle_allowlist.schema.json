{
  "title": "catalog/bundle_allowlist.json: catalog bundles Sridhar reviewed from their contact sheet (listed, CATALOG_BUNDLE_SPEC 8).",
  "type": "object",
  "required": [
    "reviewed"
  ],
  "additionalProperties": false,
  "properties": {
    "reviewed": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "hash",
          "id",
          "version",
          "reviewed"
        ],
        "additionalProperties": false,
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^sha256-[0-9a-f]{64}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,31}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
          },
          "reviewed": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
          }
        }
      }
    }
  }
}
