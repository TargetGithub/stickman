{
  "title": "Math templates and money for workbooks (education/math.json, WORKBOOK_SPEC 8.4): problem generators for math_facts, and the coins and bills the coins activity draws.",
  "type": "object",
  "required": [
    "description",
    "templates",
    "money"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300
    },
    "templates": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "tags",
          "grade",
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,23}$"
            }
          },
          "grade": {
            "enum": [
              "prek",
              "k",
              "1",
              "2",
              "3",
              "4",
              "5"
            ]
          },
          "strand": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,23}$"
          },
          "op": {
            "enum": [
              "+",
              "-",
              "×",
              "÷"
            ]
          },
          "a": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "b": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "quotient": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": -1000000,
              "maximum": 1000000
            }
          },
          "aSet": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "bSet": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          },
          "max": {
            "type": "integer"
          },
          "min": {
            "type": "integer"
          },
          "regroup": {
            "type": "boolean"
          },
          "missing": {
            "enum": [
              "answer",
              "a",
              "b"
            ]
          },
          "remainder": {
            "type": "boolean"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "form": {
            "enum": [
              "across",
              "stacked"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    },
    "money": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "tags",
          "value",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,23}$"
            }
          },
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5
          },
          "size": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "kind": {
            "enum": [
              "coin",
              "bill"
            ]
          }
        }
      }
    }
  }
}
