{
  "title": "catalog/bundle_blocklist.json: catalog bundles that may not be imported or played (CATALOG_BUNDLE_SPEC 8).",
  "type": "object",
  "required": [
    "blocked"
  ],
  "additionalProperties": false,
  "properties": {
    "blocked": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "hash",
          "id",
          "reason",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^sha256-[0-9a-f]{64}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,31}$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
          }
        }
      }
    }
  }
}
