{
  "title": "catalog/base_names.json: the base names of the last release; bundles refer to them, so they are a public interface (CATALOG_BUNDLE_SPEC 9). Written only on purpose (node tools/catalog_build.mjs --release-names).",
  "type": "object",
  "required": [
    "schemaVersion",
    "names"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poses": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$"
          }
        },
        "moves": {
