{
  "title": "catalog/story/blocklist.json: blocked words (errors) and soft words (warnings with an alternative).",
  "type": "object",
  "required": ["blocklist", "softWords"],
  "additionalProperties": false,
  "properties": {
    "blocklist": { "type": "array", "items": { "type": "string", "minLength": 2 } },
    "softWords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "alt", "audiences"],
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
          "alt": { "type": "string" },
          "audiences": { "type": "array", "minItems": 1, "items": { "enum": ["kids", "general"] } }
        }
      }
    }
  }
}
