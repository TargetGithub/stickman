{
  "title": "catalog/story/tts_voices.json: default Piper voices per timbre and the narrator (SPEECH_SPEC 5).",
  "type": "object",
  "required": ["description", "backend", "timbres", "narrator"],
  "additionalProperties": false,
  "$defs": {
    "voice": {
      "type": "object",
      "required": ["description", "tags"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 8, "maxLength": 200 },
        "tags": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" } },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "speaker": { "type": "integer", "minimum": 0 },
        "rate": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "pitch": { "type": "number", "minimum": -12, "maximum": 12 },
        "pitchScale": { "type": "number", "minimum": 0, "maximum": 2 },
        "pitchOffset": { "type": "number", "minimum": -12, "maximum": 12 },
        "pitchMin": { "type": "number", "minimum": -12, "maximum": 12 },
        "pitchMax": { "type": "number", "minimum": -12, "maximum": 12 },
        "rateScale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "filter": { "enum": ["robot"] },
        "off": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "description": { "type": "string", "minLength": 8 },
    "backend": { "enum": ["piper"] },
    "timbres": { "type": "object", "additionalProperties": { "$ref": "#/$defs/voice" } },
    "narrator": { "$ref": "#/$defs/voice" }
  }
}
