{
  "title": "Pictures made of shapes (education/shape_pictures.json, WORKBOOK_SPEC 8.1): parts in a unit box, x right and y down.",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,23}$" },
  "additionalProperties": {
    "type": "object",
    "required": ["description", "tags", "grade", "parts"],
    "additionalProperties": false,
    "properties": {
      "description": { "type": "string", "minLength": 8, "maxLength": 200 },
      "tags": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" } },
      "grade": { "enum": ["prek", "k", "1", "2"] },
      "parts": { "type": "array", "minItems": 2, "maxItems": 24, "items": {
        "type": "object",
        "required": ["shape", "x", "y", "size"],
        "additionalProperties": false,
        "properties": {
          "shape": { "type": "string" },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "size": { "type": "number", "minimum": 0.02, "maximum": 1 },
          "rotate": { "type": "number", "minimum": -360, "maximum": 360 }
        }
      } }
    }
  }
}
