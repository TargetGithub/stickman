{
  "title": "catalog/bundles.json: the bundle registry. `base` (this folder) comes first; every other entry is a bundle a script may declare, found at `path` (relative to the project root) or in the store by hash.",
  "type": "object",
  "required": ["description", "schemaVersion", "store", "bundles"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "minLength": 8 },
    "schemaVersion": { "const": 1 },
    "store": { "type": "string", "pattern": "^[a-z][a-z0-9_/-]{0,63}$" },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "version", "name", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 48 },
          "description": { "type": "string", "minLength": 8, "maxLength": 300 },
          "path": { "type": "string", "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_./-]{0,127}$", "description": "A folder relative to the project root (no .. segments); without it the bundle is looked up in the store by hash." },
          "hash": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$", "description": "The bundle's contentHash; the loader refuses a folder whose hash differs." }
        }
      }
    }
  }
}
