{
  "title": "A move file (catalog/moves/<file>.json): a list of moves (spec 8.1) with a description and tags.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "description", "tags", "category", "duration", "keys"],
    "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
      "description": { "type": "string", "minLength": 8, "maxLength": 200 },
      "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" }
      },
      "category": { "type": "string" },
      "duration": { "type": "number", "minimum": 0.05, "maximum": 10 },
      "keys": { "type": "array", "minItems": 1 }
    }
  }
}
