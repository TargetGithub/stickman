{
  "title": "catalog/characters/presets/<id>.json: a ready-made character (section 4.1).",
  "type": "object",
  "required": ["id", "name", "description", "role", "tags", "audience", "cast"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 16 },
    "description": { "type": "string", "minLength": 8, "maxLength": 200 },
    "role": { "type": "string" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" }
    },
    "series": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$", "description": "The series this character belongs to (series/<name>/); the context pack lists series presets by name only." },
    "audience": { "type": "array", "minItems": 1, "items": { "enum": ["kids", "general"] } },
    "cast": { "type": "object", "required": ["color"] }
  }
}
