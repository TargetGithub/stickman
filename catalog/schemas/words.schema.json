{
  "title": "Word lists for workbooks (education/words.json, WORKBOOK_SPEC 8.2): topics of words, each with the first grade it suits.",
  "type": "object",
  "required": ["description", "topics"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "minLength": 8, "maxLength": 300 },
    "topics": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,23}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["description", "words"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 4, "maxLength": 120 },
          "words": { "type": "object", "propertyNames": { "pattern": "^[a-z]{2,12}$" }, "additionalProperties": { "enum": ["prek", "k", "1", "2", "3", "4", "5"] } }
        }
      }
    }
  }
}
