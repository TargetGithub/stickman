{
  "title": "catalog/story/music_moods.json: scales and moods.",
  "type": "object",
  "required": ["scales", "moods"],
  "additionalProperties": false,
  "properties": {
    "scales": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 5, "items": { "type": "integer", "minimum": 0, "maximum": 11 } }
    },
    "moods": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "tags"],
        "properties": {
          "description": { "type": "string", "minLength": 8, "maxLength": 200 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" }
          },
          "scale": { "type": "string" }
        }
      }
    }
  }
}
