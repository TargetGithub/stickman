{
  "title": "Keyed entries with a description and tags (fx, themes, objects, props, faces, bodies, activities).",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["description", "tags"],
    "properties": {
      "description": { "type": "string", "minLength": 8, "maxLength": 200 },
      "tags": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" }
      }
    }
  }
}
