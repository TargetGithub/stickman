{
  "title": "catalog/story/templates.json: script fragments a version 3 script can use in place of a scene (ENGINE_V3_SPEC 6): params and a fragment with ${name} placeholders.",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 64,
  "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
  "additionalProperties": {
    "type": "object",
    "required": ["description", "tags", "params", "fragment"],
    "additionalProperties": false,
    "properties": {
      "description": { "type": "string", "minLength": 8, "maxLength": 200 },
      "tags": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" } },
      "params": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$" },
        "additionalProperties": {
          "type": "object",
          "required": ["type", "description"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["string", "number", "boolean", "array"] },
            "description": { "type": "string", "minLength": 3, "maxLength": 120 },
            "required": { "type": "boolean" },
            "default": { "type": ["string", "number", "boolean", "array"] },
            "enum": { "type": "array", "minItems": 1, "maxItems": 32 },
            "maxLength": { "type": "integer", "minimum": 1, "maximum": 400 }
          }
        }
      },
      "fragment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scenes": { "type": "array", "minItems": 1, "maxItems": 8 },
          "text": { "type": "array", "maxItems": 32 },
          "layers": { "type": "array", "maxItems": 16 },
          "shapes": { "type": "array", "maxItems": 32 },
          "tracks": { "type": "array", "maxItems": 32 },
          "audioTracks": { "type": "array", "maxItems": 16 },
          "markers": { "type": "array", "maxItems": 16 }
        }
      }
    }
  }
}
