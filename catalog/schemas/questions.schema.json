{
  "title": "Question sets for the choose activity (education/questions.json, WORKBOOK_SPEC 8.5): multiple-choice questions by strand and grade; answer is the index of the right option.",
  "type": "object",
  "required": [
    "description",
    "sets"
  ],
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 8,
      "maxLength": 300
    },
    "sets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "description",
          "tags",
          "grade",
          "strand",
          "questions"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,23}$"
            }
          },
          "grade": {
            "enum": [
              "prek",
              "k",
              "1",
              "2",
              "3",
              "4",
              "5"
            ]
          },
          "strand": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,23}$"
          },
          "questions": {
            "type": "array",
            "minItems": 4,
            "maxItems": 16,
            "items": {
              "type": "object",
              "required": [
                "q",
                "answer"
              ],
              "additionalProperties": false,
              "properties": {
                "q": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 120
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                },
                "answer": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  ]
                },
                "lines": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          }
        }
      }
    }
  }
}
