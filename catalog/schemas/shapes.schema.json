{
  "title": "2D shapes for workbooks (education/shapes.json, WORKBOOK_SPEC 8.1): facts for lessons and geometry in a unit box.",
  "type": "object",
  "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,23}$" },
  "additionalProperties": {
    "type": "object",
    "required": ["label", "description", "tags", "grade", "sides", "corners", "rightAngles", "equalSides", "curved", "symmetry", "examples", "geometry"],
    "additionalProperties": false,
    "properties": {
      "label": { "type": "string", "minLength": 3, "maxLength": 24, "description": "The name as a child reads it." },
      "description": { "type": "string", "minLength": 8, "maxLength": 200 },
      "tags": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$" } },
      "grade": { "enum": ["prek", "k", "1", "2", "3", "4", "5"] },
      "also": { "type": "array", "items": { "type": "string" }, "description": "Other names (a diamond is a rhombus)." },
      "sides": { "type": "integer", "minimum": 0, "maximum": 20 },
      "corners": { "type": "integer", "minimum": 0, "maximum": 20 },
      "rightAngles": { "type": "integer", "minimum": 0, "maximum": 20 },
      "equalSides": { "enum": ["all", "pairs", "two", "some", "none"] },
      "curved": { "type": "boolean" },
      "symmetry": { "type": "integer", "minimum": -1, "maximum": 12, "description": "Lines of symmetry; -1 for infinitely many." },
      "examples": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "minLength": 2, "maxLength": 24 } },
      "note": { "type": "string", "minLength": 8, "maxLength": 120 },
      "geometry": {
        "oneOf": [
          { "type": "object", "required": ["kind", "sides"], "additionalProperties": false, "properties": { "kind": { "const": "regular" }, "sides": { "type": "integer", "minimum": 3, "maximum": 12 } } },
          { "type": "object", "required": ["kind", "points"], "additionalProperties": false, "properties": { "kind": { "const": "polygon" }, "points": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -1, "maximum": 1 } } } } },
          { "type": "object", "required": ["kind", "rx", "ry"], "additionalProperties": false, "properties": { "kind": { "const": "ellipse" }, "rx": { "type": "number", "minimum": 0.1, "maximum": 1 }, "ry": { "type": "number", "minimum": 0.1, "maximum": 1 } } },
          { "type": "object", "required": ["kind", "points", "inner"], "additionalProperties": false, "properties": { "kind": { "const": "star" }, "points": { "type": "integer", "minimum": 3, "maximum": 12 }, "inner": { "type": "number", "minimum": 0.1, "maximum": 0.9 } } },
          { "type": "object", "required": ["kind", "from", "to"], "additionalProperties": false, "properties": { "kind": { "const": "sector" }, "from": { "type": "number", "minimum": -360, "maximum": 360 }, "to": { "type": "number", "minimum": -360, "maximum": 360 } } },
          { "type": "object", "required": ["kind", "offset", "inner"], "additionalProperties": false, "properties": { "kind": { "const": "crescent" }, "offset": { "type": "number", "minimum": 0.1, "maximum": 0.9 }, "inner": { "type": "number", "minimum": 0.3, "maximum": 1 } } },
          { "type": "object", "required": ["kind", "inner"], "additionalProperties": false, "properties": { "kind": { "const": "ring" }, "inner": { "type": "number", "minimum": 0.2, "maximum": 0.8 } } },
          { "type": "object", "required": ["kind", "d"], "additionalProperties": false, "properties": { "kind": { "const": "path" }, "d": { "type": "array", "minItems": 2, "items": { "type": "array", "minItems": 1 } } } }
        ],
        "x-discriminator": "kind"
      }
    }
  }
}
